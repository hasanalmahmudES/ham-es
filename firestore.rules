rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Friendship documents use the two user ids sorted and joined by "_".
    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }
    function areFriends(id) {
      return exists(/databases/$(database)/documents/friendships/$(id))
          && get(/databases/$(database)/documents/friendships/$(id)).data.status == 'accepted';
    }
    function friendsWith(other) {
      return areFriends(pairId(request.auth.uid, other));
    }

    // Public profiles: any logged-in member can see them, only you can edit yours.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 50;
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.name.size() <= 50
                    && request.resource.data.bio.size() <= 160
                    && request.resource.data.get('location', '').size() <= 60
                    && request.resource.data.get('photo', '').size() <= 30000;

      // Date of birth and mobile number. Owner always; friends only if the owner chose "My friends".
      match /private/{doc} {
        allow read: if signedIn()
                    && (request.auth.uid == uid
                        || (resource.data.share == 'friends' && friendsWith(uid)));
        allow write: if signedIn() && request.auth.uid == uid
                     && request.resource.data.share in ['me', 'friends']
                     && request.resource.data.get('mobile', '').size() <= 20
                     && request.resource.data.get('dob', '').size() <= 10;
      }
    }

    // Friend requests.
    match /friendships/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn()
                    && request.resource.data.from == request.auth.uid
                    && request.auth.uid in request.resource.data.users
                    && request.resource.data.users.size() == 2
                    && request.resource.data.status == 'pending'
                    && id.split('_').hasAll(request.resource.data.users);
      allow update: if signedIn()
                    && request.auth.uid in resource.data.users
                    && resource.data.from != request.auth.uid
                    && request.resource.data.status == 'accepted'
                    && request.resource.data.users == resource.data.users;
      allow delete: if signedIn() && request.auth.uid in resource.data.users;
    }

    // Chats. "public" is the Community Room (open to all members).
    // Private chats are only for accepted friends. Chat id = the same sorted pair id.
    match /chats/{chatId} {
      allow read: if signedIn()
                  && (chatId == 'public' || request.auth.uid in resource.data.members);
      allow create: if signedIn()
                    && (chatId == 'public'
                        || (request.auth.uid in request.resource.data.members
                            && request.resource.data.members.size() == 2
                            && chatId.split('_').hasAll(request.resource.data.members)
                            && areFriends(chatId)));
      allow update: if signedIn()
                    && (chatId == 'public'
                        || (request.auth.uid in resource.data.members && areFriends(chatId)));

      match /messages/{msgId} {
        allow read: if signedIn()
                    && (chatId == 'public' || request.auth.uid in chatId.split('_'));
        allow create: if signedIn()
                      && (chatId == 'public'
                          || (request.auth.uid in chatId.split('_') && areFriends(chatId)))
                      && request.resource.data.from == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 1000;
        allow update, delete: if false;
      }
    }
  }
}
